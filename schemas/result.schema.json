{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:shinra-bansho-kan:schemas:result:1.0.0",
  "title": "森羅万象鑑 鑑定結果",
  "type": "object",
  "required": [
    "schemaVersion",
    "subject",
    "meta",
    "baseInfo",
    "systems",
    "crossAnalysis",
    "domainProfiles",
    "summary",
    "limitations",
    "assets"
  ],
  "properties": {
    "schemaVersion": {
      "type": "string",
      "pattern": "^1\\."
    },
    "subject": {
      "type": "object"
    },
    "meta": {
      "type": "object"
    },
    "baseInfo": {
      "type": "object"
    },
    "systems": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "status",
          "inputsUsed",
          "calculations",
          "facts",
          "interpretation",
          "uncertainties",
          "sources"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "status": {
            "type": "string"
          },
          "inputsUsed": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "calculations": {
            "$ref": "#/$defs/entries"
          },
          "facts": {
            "$ref": "#/$defs/entries"
          },
          "interpretation": {
            "$ref": "#/$defs/entries"
          },
          "uncertainties": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "sources": {
            "$ref": "#/$defs/entries"
          }
        },
        "additionalProperties": true
      }
    },
    "crossAnalysis": {
      "type": "object",
      "required": [
        "strongThemes",
        "moderateThemes",
        "contradictions",
        "dependencyWarnings"
      ],
      "properties": {
        "strongThemes": {
          "$ref": "#/$defs/entries"
        },
        "moderateThemes": {
          "$ref": "#/$defs/entries"
        },
        "contradictions": {
          "$ref": "#/$defs/entries"
        },
        "dependencyWarnings": {
          "$ref": "#/$defs/entries"
        }
      },
      "additionalProperties": true
    },
    "domainProfiles": {
      "type": "object"
    },
    "summary": {
      "oneOf": [
        {
          "type": "string"
        },
        {
          "type": "object"
        }
      ]
    },
    "limitations": {
      "oneOf": [
        {
          "type": "array"
        },
        {
          "type": "object"
        }
      ]
    },
    "assets": {
      "type": "object",
      "properties": {
        "shareImage": {
          "type": "string",
          "description": "Optional path or data URL for an imported raster card; omit if unavailable."
        },
        "shareCardCopy": {
          "type": "object",
          "properties": {
            "title": {
              "type": "string",
              "minLength": 1,
              "maxLength": 40
            },
            "description": {
              "type": "string",
              "minLength": 1,
              "maxLength": 120
            },
            "themes": {
              "type": "array",
              "minItems": 0,
              "maxItems": 3,
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 24
              }
            },
            "visualMotifs": {
              "type": "array",
              "minItems": 0,
              "maxItems": 5,
              "items": {
                "type": "object",
                "required": [
                  "sourceSystem",
                  "sourceFact",
                  "visualMotif"
                ],
                "properties": {
                  "sourceSystem": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 80
                  },
                  "sourceFact": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 100
                  },
                  "visualMotif": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 160
                  }
                },
                "additionalProperties": false
              },
              "description": "算出済みの占術事実から導くカード用の視覚モチーフ"
            },
            "sections": {
              "type": "array",
              "maxItems": 8,
              "items": {
                "type": "object",
                "properties": {
                  "heading": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 40
                  },
                  "text": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 360
                  },
                  "items": {
                    "type": "array",
                    "maxItems": 5,
                    "items": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 120
                    }
                  },
                  "sourceFacts": {
                    "type": "array",
                    "maxItems": 5,
                    "items": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 100
                    }
                  }
                },
                "additionalProperties": true
              },
              "description": "個人情報を含まず、鑑定の結論・人物像・強み・注意・具体策などを画像に焼き込むための構造化コピー"
            }
          },
          "additionalProperties": true,
          "description": "鑑定完了・スキーマ検証後に作る個人情報を含まないカード本文"
        },
        "shareGeneration": {
          "type": "object",
          "properties": {
            "status": {
              "enum": [
                "generated",
                "unavailable",
                "failed"
              ]
            },
            "provider": {
              "type": "string",
              "minLength": 1
            },
            "model": {
              "type": "string",
              "minLength": 1
            },
            "toolUsed": {
              "type": "string",
              "minLength": 1
            },
            "sourceFacts": {
              "type": "array",
              "maxItems": 5,
              "items": {
                "type": "object",
                "properties": {
                  "sourceSystem": {
                    "type": "string"
                  },
                  "sourceFact": {
                    "type": "string"
                  },
                  "visualMotif": {
                    "type": "string"
                  }
                },
                "additionalProperties": false
              }
            },
            "width": {
              "type": "integer",
              "minimum": 1
            },
            "height": {
              "type": "integer",
              "minimum": 1
            },
            "message": {
              "type": "string"
            }
          },
          "additionalProperties": true,
          "description": "Optional truthful record of image generation. It never determines whether the reading ZIP is valid."
        }
      },
      "additionalProperties": true
    }
  },
  "$defs": {
    "entries": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "string"
          },
          {
            "type": "object"
          }
        ]
      }
    }
  },
  "additionalProperties": true
}
